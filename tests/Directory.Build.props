<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <BaseOutputPath>..\bin\$(MSBuildProjectName)</BaseOutputPath>
        <BaseIntermediateOutputPath>..\obj\$(MSBuildProjectName)</BaseIntermediateOutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
        <PackageReference Include="MSTest" Version="3.8.2" />
        <PackageReference Include="coverlet.msbuild" Version="10.0.1" PrivateAssets="all" />
        <ProjectReference
            Include="$(MSBuildThisFileDirectory)..\..\AlvorKit\src\AlvorKit.Logging\AlvorKit.Logging.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="AlvorKit.Logging" />
        <Using Include="Craftdig.Protocol" />
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
        <Using Include="System.Buffers.Binary" />
        <Using Include="System.Security.Cryptography" />
        <Using Include="System.Text" />
    </ItemGroup>

</Project>
