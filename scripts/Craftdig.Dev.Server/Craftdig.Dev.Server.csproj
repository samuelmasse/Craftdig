<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ApplicationIcon>..\..\res\Icons\Server.ico</ApplicationIcon>
        <AssemblyTitle>Craftdig Server</AssemblyTitle>
        <Product>Craftdig Server</Product>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Craftdig.Unit">
            <Static>true</Static>
        </Using>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Condition="!Exists('$(BindingsRoot)\AlvorKit.FastNoise2.Backend\AlvorKit.FastNoise2.Backend.csproj')"
            Include="AlvorKit.FastNoise2.Backend" Version="1.1.1.3" />
        <ProjectReference Condition="Exists('$(BindingsRoot)\AlvorKit.FastNoise2.Backend\AlvorKit.FastNoise2.Backend.csproj')"
            Include="$(BindingsRoot)\AlvorKit.FastNoise2.Backend\AlvorKit.FastNoise2.Backend.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Craftdig.Native.Backend\Craftdig.Native.Backend.csproj" />
        <ProjectReference Include="..\..\src\Craftdig.Server\Craftdig.Server.csproj" />
    </ItemGroup>

</Project>
